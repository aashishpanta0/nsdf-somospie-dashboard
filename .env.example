# Copy to .env and adjust. .env is git-ignored and excluded from the image.
SOMOSPIE_IMAGE=ghcr.io/aashishpanta0/nsdf-somospie-dashboard:latest
SOMOSPIE_PLATFORM=linux/amd64
# Host interface the dashboard is published on.
SOMOSPIE_BIND_ADDRESS=127.0.0.1
# Used for both the container listener and the published host port.
SOMOSPIE_PORT=11657
# Keep 0.0.0.0 so Docker port publishing can reach the server.
SOMOSPIE_LISTEN_ADDRESS=0.0.0.0
# Allowed WebSocket origin(s); set to the public hostname in production.
SOMOSPIE_ALLOW_WS_ORIGIN=*
# Required. Replace the Wasabi credentials; keep real keys only in .env (git-ignored).
SOMOSPIE_DATASET='https://s3.us-east-1.wasabisys.com/scientistcloud/utk/nsdf_somospie/conus_30m_terrain/CONUS_30m_Terrain_Parameters.idx?access_key=Y69B9WJPYXDQBM4DE8LL&secret_key=LJEz1AUsvTW6uNJc67NNgfD3IfNYrIY54zps6PWU&endpoint_url=https://s3.us-east-1.wasabisys.com&cached=arco'
